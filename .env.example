# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: Required for shared data + photo storage.
# Get these from your Supabase project: Settings -> API.
# The anon key is safe to expose client-side (it's the public key by design);
# access is controlled by Row Level Security policies on the tables/bucket.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_ANON_KEY"
